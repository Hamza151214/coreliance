{
  "rules": {
    "careerCases": {
      ".read": "auth != null",
      ".write": false
    },
    "jobSeekerProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['status', 'university', 'degree', 'desiredRoles'])"
      }
    }
  }
}
